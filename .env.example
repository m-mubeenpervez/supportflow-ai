
# Gemini AI Configuration
GEMINI_API_KEY=replace_me
GEMINI_ROUTING_MODEL=gemini-3.5-flash-lite
GEMINI_ROUTING_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_RESPONSE_MODEL=gemini-3.5-flash-lite
GEMINI_RESPONSE_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBED_DIM=768
GEMINI_ROUTER_MIN_CONFIDENCE=0.72

# Fresh-install PostgreSQL/pgvector database created by Compose.
# Keep this database separate from any recovered/local deployment.
POSTGRES_DB=supportflow_db
POSTGRES_USER=supportflow_user
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://supportflow_user:replace_with_a_long_random_password@postgres:5432/supportflow_db
DATABASE_HOST_OVERRIDE=
APPLICATION_DATABASE_NAME=supportflow_db

# JWT Authentication
JWT_SECRET_KEY=replace_with_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin Configuration
ADMIN_TOKEN=replace_with_secure_admin_token

# Frontend Configuration
CORS_ORIGINS=http://localhost:5173
ADMIN_JWT_ROUTES_ENABLED=true

# ==========================================
# Email verification and notifications
# ==========================================
# Keep SMTP disabled until a real provider is configured.
# Registration still requires a valid Fernet key and base URL.
# Generate a key privately using:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit real encryption keys or SMTP credentials.
EMAIL_DELIVERY_ENABLED=false
EMAIL_DELIVERY_MODE=test
# Comma-separated, privately approved addresses used only in test mode.
EMAIL_TEST_ALLOWED_RECIPIENTS=
VERIFICATION_EMAIL_ENCRYPTION_KEY=
VERIFICATION_EMAIL_BASE_URL=http://localhost:5173/verify-email
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
EMAIL_SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM_ADDRESS=
ADMIN_NOTIFICATION_EMAIL=
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_POLL_SECONDS=30
EMAIL_MAX_ATTEMPTS=3
